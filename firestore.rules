rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isInboxOwner() {
      return request.auth != null
        && request.auth.token.email == 'mjhmbrur@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'category', 'message', 'page', 'uid', 'email',
          'displayName', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'category', 'message', 'page', 'uid', 'email',
          'displayName', 'status', 'createdAt'
        ])
        && request.resource.data.category in [
          'Report a problem', 'Suggest an improvement',
          'Ask a question', 'Other feedback'
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 2048
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow get, list: if isInboxOwner();
      allow update: if isInboxOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'reviewed'];
      allow delete: if isInboxOwner();
    }

    match /users/{userId} {
      allow get: if request.auth != null
        && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'email', 'photoURL', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.updatedAt == request.time;

      match /testResults/{resultId} {
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'subjectId', 'subjectName', 'testName',
            'score', 'totalQuestions', 'completedAt'
          ])
          && request.resource.data.keys().hasAll([
            'subjectId', 'subjectName', 'testName',
            'score', 'totalQuestions', 'completedAt'
          ])
          && request.resource.data.subjectId in [
            'assurance', 'btf', 'financial-accounting',
            'management-information', 'principles-of-taxation',
            'business-laws', 'information-technology'
          ]
          && request.resource.data.subjectName is string
          && request.resource.data.subjectName.size() <= 80
          && request.resource.data.testName is string
          && request.resource.data.testName.size() > 0
          && request.resource.data.testName.size() <= 160
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.totalQuestions is int
          && request.resource.data.totalQuestions > 0
          && request.resource.data.score <= request.resource.data.totalQuestions
          && request.resource.data.completedAt == request.time;

        allow get, list: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /users/{userId}/activities/{activityId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'subjectId', 'subjectName', 'activityName',
          'score', 'totalQuestions', 'completedAt'
        ])
        && request.resource.data.keys().hasAll([
          'subjectId', 'subjectName', 'activityName',
          'score', 'totalQuestions', 'completedAt'
        ])
        && request.resource.data.subjectId in ['assurance', 'btf']
        && request.resource.data.subjectName is string
        && request.resource.data.subjectName.size() <= 80
        && request.resource.data.activityName is string
        && request.resource.data.activityName.size() > 0
        && request.resource.data.activityName.size() <= 160
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.totalQuestions is int
        && request.resource.data.totalQuestions > 0
        && request.resource.data.score <= request.resource.data.totalQuestions
        && request.resource.data.completedAt == request.time;

      allow get, list: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
